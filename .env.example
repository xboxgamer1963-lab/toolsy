# Public URL of the deployed site (used for canonical URLs, sitemap, robots.txt)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Google AdSense publisher ID, e.g. ca-pub-1234567890123456.
# When empty, no ad code is loaded at all.
NEXT_PUBLIC_ADSENSE_CLIENT=

# Optional: ad unit slot IDs for manual placements. Leave empty to rely on Auto ads.
NEXT_PUBLIC_ADSENSE_SLOT_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_BOTTOM=

# Contact address shown on the Contact page
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com
